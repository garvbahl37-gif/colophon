# ═══ Model routing ═══════════════════════════════════════════════════════════
# Every stage names its own backend:
#   ollama:<model>    Ollama Cloud          needs OLLAMA_API_KEY
#   gateway:<model>   Vercel AI Gateway     needs AI_GATEWAY_API_KEY
#   google:<model>    Google, direct        needs GOOGLE_GENERATIVE_AI_API_KEY
#   local:<hf-model>  in-process ONNX       needs nothing
#   <model>           bare = gateway
#
# Default routing runs generation on Ollama Cloud and retrieval locally, so the
# whole system works with one key and no embedding provider.

OLLAMA_API_KEY=
# AI_GATEWAY_API_KEY=            # only needed if a stage is routed to gateway:

MODEL_GENERATE=ollama:gpt-oss:120b
MODEL_PLAN=ollama:gpt-oss:20b
MODEL_CONTEXTUALIZE=ollama:gpt-oss:20b
MODEL_GRADE=ollama:gpt-oss:20b
MODEL_EMBED=local:Xenova/bge-base-en-v1.5
MODEL_RERANK=local:Xenova/ms-marco-MiniLM-L-6-v2

# Highest-quality alternative (requires AI_GATEWAY_API_KEY):
#   MODEL_GENERATE=gateway:anthropic/claude-sonnet-5
#   MODEL_PLAN=gateway:anthropic/claude-haiku-4.5
#   MODEL_CONTEXTUALIZE=gateway:anthropic/claude-haiku-4.5
#   MODEL_GRADE=gateway:anthropic/claude-haiku-4.5
#   MODEL_EMBED=gateway:voyage/voyage-3-large      (then EMBEDDING_DIMENSIONS=1024)
#   MODEL_RERANK=gateway:cohere/rerank-v4-pro

# ═══ Database ════════════════════════════════════════════════════════════════
DATABASE_URL=postgres://localhost:5432/colophon

# ═══ Retrieval tuning ════════════════════════════════════════════════════════
# db:setup probes the embedding model and builds the column to match, so this
# is only a fallback for when no model is reachable at setup time.
EMBEDDING_DIMENSIONS=768

RETRIEVAL_CANDIDATES=40          # candidates per arm, per sub-query
RETRIEVAL_DENSE_WEIGHT=0.5       # RRF weight for the pgvector arm
RETRIEVAL_SPARSE_WEIGHT=0.5      # RRF weight for the full-text arm
RETRIEVAL_IDENTIFIER_WEIGHT=0.6  # verbatim-identifier arm; 0 disables it
RETRIEVAL_RRF_K=60               # RRF smoothing constant
RETRIEVAL_RERANK_TOP_N=10        # survivors of the cross-encoder
RETRIEVAL_CONTEXT_CHUNKS=8       # passages that reach the generator
RETRIEVAL_MAX_HOPS=2             # agentic re-retrieval budget
RETRIEVAL_MMR_LAMBDA=0.72        # 1.0 = pure relevance, 0.0 = pure diversity
RETRIEVAL_NEIGHBOR_WINDOW=1      # small-to-big expansion radius
RETRIEVAL_EF_SEARCH=120          # HNSW search breadth

# ═══ Ingestion ═══════════════════════════════════════════════════════════════
CONTEXTUAL_RETRIEVAL=true        # Anthropic-style situating context per chunk
CONTEXTUAL_CONCURRENCY=8
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=64

# Schema Colophon owns. Use a dedicated one (e.g. "colophon") on a shared
# database such as Supabase, where public.documents very likely already exists.
DB_SCHEMA=public

# ═══ Supabase (serverless-safe retrieval) ════════════════════════════════════
# Vercel's runtime has no native ONNX libraries, so `local:` embeddings cannot
# run there. gte-small runs natively inside a Supabase Edge Function instead —
# no extra provider, no model download on cold start.
#   MODEL_EMBED=supabase:gte-small        (384 dimensions)
#   MODEL_RERANK=llm:listwise             (no cross-encoder available)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Gates ingest and delete. Required on any public deployment; a deployment
# without it refuses writes rather than accepting them from strangers.
COLOPHON_WRITE_TOKEN=

# ═══ Ingestion cost and shape ════════════════════════════════════════════════
# Contextualisation is the expensive half of ingest: one generation per group of
# chunks. These are the knobs that decide how long a document takes to index.
# CONTEXTUAL_BATCH_SIZE=28          # chunks described per call; cost is ~11s + 1.2s each,
#                                   # so the fewest, largest calls win
# CONTEXTUAL_MAX_DOC_CHARS=12000    # at or under this the whole document is sent
# CONTEXTUAL_WINDOW_CHARS=6000      # otherwise: an outline plus this much nearby prose
# CHUNK_MIN_TOKENS=120
# CHUNK_MAX_TOKENS=900
# EMBEDDING_BATCH_SIZE=96

# ═══ Retrieval knobs not covered above ═══════════════════════════════════════
# RETRIEVAL_MIN_RERANK_SCORE=0.015  # below this a rerank score is treated as noise

# ═══ Answer cache ════════════════════════════════════════════════════════════
# Answers are reused when a near-identical question is asked against the same
# documents by the same browser. Near-identical, not paraphrased: the floor sits
# at 0.90 cosine because question similarity does not cleanly separate "same
# question" from "different question about the same thing".
# SEMANTIC_CACHE=true

# ═══ Public deployment limits ════════════════════════════════════════════════
# A spend ceiling, not an access control: anyone may add documents, nobody may
# add ten thousand. Counted from the corpus itself, so it holds across instances.
# COLOPHON_DAILY_CHUNK_BUDGET=600

# Store full question and answer text in query_log. Off by default and should
# stay off on anything shared: the conversation is the most sensitive thing here
# and the table is one nobody can see or clear. Local evaluation only.
# COLOPHON_LOG_QUERIES=0

# ═══ Provider endpoints ══════════════════════════════════════════════════════
# OLLAMA_BASE_URL=https://ollama.com    # override for a self-hosted Ollama

# ═══ Google ══════════════════════════════════════════════════════════════════
# The only backend here that serves both generation AND embeddings, so one key
# can cover a whole pipeline instead of straddling Ollama and a Supabase Edge
# Function. It also answers concurrent requests concurrently, which Ollama Cloud
# does not — four parallel calls there take four times as long as one, and that
# single fact is why ingestion is measured in minutes and why the router skips
# reranking on lookups. Key from aistudio.google.com.
# GOOGLE_GENERATIVE_AI_API_KEY=
#
# A pipeline routed entirely through Google:
#   MODEL_GENERATE=google:gemini-2.5-flash
#   MODEL_PLAN=google:gemini-2.5-flash-lite
#   MODEL_CONTEXTUALIZE=google:gemini-2.5-flash-lite
#   MODEL_GRADE=google:gemini-2.5-flash-lite
#   MODEL_EMBED=google:text-embedding-004
#   EMBEDDING_DIMENSIONS=768
#
# Changing the embedding model changes the vector width, and a column cannot be
# re-widened in place: run pnpm db:reset and re-ingest, or the first insert
# fails on a dimension mismatch.
