# ═══ Model routing ═══════════════════════════════════════════════════════════
# Every stage names its own backend:
#   ollama:<model>    Ollama Cloud          needs OLLAMA_API_KEY
#   gateway:<model>   Vercel AI Gateway     needs AI_GATEWAY_API_KEY
#   local:<hf-model>  in-process ONNX       needs nothing
#   <model>           bare = gateway
#
# Default routing runs generation on Ollama Cloud and retrieval locally, so the
# whole system works with one key and no embedding provider.

OLLAMA_API_KEY=
# AI_GATEWAY_API_KEY=            # only needed if a stage is routed to gateway:

MODEL_GENERATE=ollama:gpt-oss:120b
MODEL_PLAN=ollama:gpt-oss:20b
MODEL_CONTEXTUALIZE=ollama:gpt-oss:20b
MODEL_GRADE=ollama:gpt-oss:20b
MODEL_EMBED=local:Xenova/bge-base-en-v1.5
MODEL_RERANK=local:Xenova/ms-marco-MiniLM-L-6-v2

# Highest-quality alternative (requires AI_GATEWAY_API_KEY):
#   MODEL_GENERATE=gateway:anthropic/claude-sonnet-5
#   MODEL_PLAN=gateway:anthropic/claude-haiku-4.5
#   MODEL_CONTEXTUALIZE=gateway:anthropic/claude-haiku-4.5
#   MODEL_GRADE=gateway:anthropic/claude-haiku-4.5
#   MODEL_EMBED=gateway:voyage/voyage-3-large      (then EMBEDDING_DIMENSIONS=1024)
#   MODEL_RERANK=gateway:cohere/rerank-v4-pro

# ═══ Database ════════════════════════════════════════════════════════════════
DATABASE_URL=postgres://localhost:5432/colophon

# ═══ Retrieval tuning ════════════════════════════════════════════════════════
# db:setup probes the embedding model and builds the column to match, so this
# is only a fallback for when no model is reachable at setup time.
EMBEDDING_DIMENSIONS=768

RETRIEVAL_CANDIDATES=40          # candidates per arm, per sub-query
RETRIEVAL_DENSE_WEIGHT=0.5       # RRF weight for the pgvector arm
RETRIEVAL_SPARSE_WEIGHT=0.5      # RRF weight for the full-text arm
RETRIEVAL_RRF_K=60               # RRF smoothing constant
RETRIEVAL_RERANK_TOP_N=10        # survivors of the cross-encoder
RETRIEVAL_CONTEXT_CHUNKS=8       # passages that reach the generator
RETRIEVAL_MAX_HOPS=2             # agentic re-retrieval budget
RETRIEVAL_MMR_LAMBDA=0.72        # 1.0 = pure relevance, 0.0 = pure diversity
RETRIEVAL_NEIGHBOR_WINDOW=1      # small-to-big expansion radius
RETRIEVAL_EF_SEARCH=120          # HNSW search breadth

# ═══ Ingestion ═══════════════════════════════════════════════════════════════
CONTEXTUAL_RETRIEVAL=true        # Anthropic-style situating context per chunk
CONTEXTUAL_CONCURRENCY=8
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=64

# Schema Colophon owns. Use a dedicated one (e.g. "colophon") on a shared
# database such as Supabase, where public.documents very likely already exists.
DB_SCHEMA=public

# ═══ Supabase (serverless-safe retrieval) ════════════════════════════════════
# Vercel's runtime has no native ONNX libraries, so `local:` embeddings cannot
# run there. gte-small runs natively inside a Supabase Edge Function instead —
# no extra provider, no model download on cold start.
#   MODEL_EMBED=supabase:gte-small        (384 dimensions)
#   MODEL_RERANK=llm:listwise             (no cross-encoder available)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Gates ingest and delete. Required on any public deployment; a deployment
# without it refuses writes rather than accepting them from strangers.
COLOPHON_WRITE_TOKEN=
